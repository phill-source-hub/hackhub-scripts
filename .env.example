# HackHub Scripts Development Environment Variables
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!

# Anthropic API Key for Claude integration
# Get your API key from: https://console.anthropic.com/account/keys
# Keep this private!
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: HackHub game directory (for future auto-deployment)
# HACKHUB_GAME_PATH=C:\Program Files (x86)\Steam\steamapps\common\HackHub - Ultimate Hacker Simulator

# Optional: Development settings
NODE_ENV=development
DEBUG=false