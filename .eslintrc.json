{
  "parser": "@typescript-eslint/parser",
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:@typescript-eslint/eslint-recommended"
  ],
  "plugins": [
    "@typescript-eslint"
  ],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "env": {
    "node": true,
    "es2020": true
  },
  "globals": {
    "println": "readonly",
    "sleep": "readonly",
    "alert": "readonly"
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": "error",
    "no-console": "warn",
    "semi": ["error", "always"],
    "quotes": ["error", "double"],
    "indent": ["error", 2],
    "no-restricted-globals": [
      "warn",
      {
        "name": "setTimeout",
        "message": "setTimeout not allowed in HackHub sandbox. Use synchronous logic instead."
      },
      {
        "name": "setInterval",
        "message": "setInterval not allowed in HackHub sandbox. Use synchronous logic instead."
      }
    ]
  }
}